# =============================================================
# NEKH XËL — Variables d'environnement
# =============================================================
# Copie ce fichier en .env.local et remplis les valeurs.
# Ne commite JAMAIS .env.local dans git.
# =============================================================

# -------------------------------------------------------------
# SUPABASE — https://supabase.com/dashboard
# Récupère ces valeurs dans : Settings > API
# -------------------------------------------------------------

# URL du projet (ex: https://abcdefghijkl.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://ton-projet.supabase.co

# Clé anonyme publique (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clé service role — NE PAS exposer côté client, uniquement serveur
# Récupère dans : Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT Secret — Récupère dans : Settings > API > JWT Settings
SUPABASE_JWT_SECRET=ton-jwt-secret-ici

# -------------------------------------------------------------
# APPLICATION
# -------------------------------------------------------------

# URL de base sans slash final
# En production : https://ton-domaine.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nom affiché dans l'interface
NEXT_PUBLIC_APP_NAME=NEKH XËL

# -------------------------------------------------------------
# TWILIO SMS (pour l'OTP téléphone)
# https://console.twilio.com
# Note : Supabase gère les SMS via son propre provider Twilio
# Configure dans : Supabase > Authentication > Providers > Phone
# -------------------------------------------------------------

# Ces variables sont utilisées directement dans Supabase Auth,
# pas dans le code Next.js. Renseigne-les dans le dashboard Supabase.
#
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_PHONE_NUMBER=+12015551234    (ou Messaging Service SID)

# -------------------------------------------------------------
# OPTIONNEL — Analytics, monitoring (pour plus tard)
# -------------------------------------------------------------

# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_SENTRY_DSN=https://...

# -------------------------------------------------------------
# Notes importantes
# -------------------------------------------------------------
# 1. En développement, Supabase peut simuler les SMS (voir SUPABASE.md)
# 2. Les variables NEXT_PUBLIC_* sont visibles dans le navigateur
# 3. Les variables sans NEXT_PUBLIC_ restent côté serveur uniquement
# 4. Redémarre `npm run dev` après toute modification de .env.local

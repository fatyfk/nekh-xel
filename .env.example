# =============================================================
#  NEKH XËL — Variables d'environnement
#  Copie ce fichier en .env.local et remplis les valeurs.
#  .env.local ne doit JAMAIS être commité dans git.
# =============================================================

# -------------------------------------------------------------
# SUPABASE OBLIGATOIRES
# Dashboard : https://supabase.com/dashboard/project/<ref>/settings/api
# -------------------------------------------------------------

# "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# "Project API keys → anon / public"
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# "Project API keys → service_role"  ← SERVEUR UNIQUEMENT, ne pas préfixer NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# "JWT Settings → JWT Secret"
SUPABASE_JWT_SECRET=votre-super-secret-jwt-doit-faire-au-moins-32-caracteres

# -------------------------------------------------------------
# APPLICATION
# -------------------------------------------------------------

# URL publique de l'app (sans slash final)
# En développement : http://localhost:3000
# En production    : https://nekh-xel.vercel.app  (ou votre domaine)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nom affiché dans l'interface
NEXT_PUBLIC_APP_NAME=NEKH XËL

# -------------------------------------------------------------
# TWILIO SMS — Notifications parents
# Uniquement nécessaire pour /api/notify-parent en production.
# En développement, les SMS ne sont pas envoyés si ces vars manquent.
# Dashboard : https://console.twilio.com
# -------------------------------------------------------------

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+12015551234

# -------------------------------------------------------------
# VERCEL (défini automatiquement par Vercel en production)
# Vous n'avez PAS besoin de les définir manuellement.
# Documentées ici pour référence.
# -------------------------------------------------------------

# VERCEL_URL          = <votre-projet>.vercel.app  (sans https://)
# VERCEL_ENV          = production | preview | development
# VERCEL_REGION       = cdg1  (Paris)
